# SPA fallback — sert index.html pour les routes gérées côté client (hébergement Apache/LiteSpeed).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Ne pas réécrire les fichiers/dossiers existants (assets)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Tout le reste -> index.html
  RewriteRule ^ index.html [L]
</IfModule>
